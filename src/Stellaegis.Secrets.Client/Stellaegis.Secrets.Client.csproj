<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Secrets.Client</RootNamespace>
    <PackageId>Stellaegis.Secrets.Client</PackageId>
    <Description>Stellaegis HTTP client for the Vault API microservice — implements ISecretsProvider/IMutableSecretsProvider over the network for multi-host deployments.</Description>
    <PackageTags>stellaegis;secrets;vault;client;http</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <ProjectReference Include="..\Stellaegis.Secrets\Stellaegis.Secrets.csproj" />
  </ItemGroup>

</Project>
