<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Secrets.AspNetCore</RootNamespace>
    <PackageId>Stellaegis.Secrets.AspNetCore</PackageId>
    <Description>Stellaegis vault ASP.NET Core integration: maps the routes of the secrets module, each labelled with its operation, and its administration route apart.</Description>
    <PackageTags>stellaegis;secrets;vault;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellaegis.Primitives.AspNetCore" />
    <ProjectReference Include="..\Stellaegis.Secrets\Stellaegis.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
