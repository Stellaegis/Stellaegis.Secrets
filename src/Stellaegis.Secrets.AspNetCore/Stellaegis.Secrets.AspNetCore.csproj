<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Secrets.AspNetCore</RootNamespace>
    <PackageId>Stellaegis.Secrets.AspNetCore</PackageId>
    <Description>Stellaegis vault ASP.NET Core integration: minimal API host setup (M2M auth, CORS, secrets endpoints, health check).</Description>
    <PackageTags>stellaegis;secrets;vault;aspnetcore</PackageTags>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stellaegis.Secrets\Stellaegis.Secrets.csproj" />
    <ProjectReference Include="..\..\Stellaegis.AspNetCore\Stellaegis.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SharpPyxis.Results" />
  </ItemGroup>

</Project>
